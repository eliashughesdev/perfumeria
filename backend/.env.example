# =============================================================================
# L'ESSENCE POS - Configuración de entorno (.env)
# Copiar este archivo a .env y ajustar los valores para el entorno on-premise
# =============================================================================

# --- Servidor FastAPI ---
APP_NAME=L'Essence POS API
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8050
API_WORKERS=1
DEBUG=True
RELOAD=True

# --- Base de datos Microsoft SQL Server (pyodbc / SQLAlchemy) ---
# Ejemplo usando Windows Authentication (Trusted_Connection=yes):
# DATABASE_URL=mssql+pyodbc://localhost/LesserencePOSDB?driver=ODBC+Driver+17+for+SQL+Server&Trusted_Connection=yes
#
# Ejemplo usando SQL Server Authentication:
# DATABASE_URL=mssql+pyodbc://sa:TuPassword123!@localhost/LesserencePOSDB?driver=ODBC+Driver+17+for+SQL+Server
DATABASE_URL=mssql+pyodbc://localhost/LesserencePOSDB?driver=ODBC+Driver+17+for+SQL+Server&Trusted_Connection=yes

# DB Driver alternativo si no está instalado ODBC Driver 17:
# DB_DRIVER=ODBC Driver 17 for SQL Server
# DB_SERVER=localhost
# DB_NAME=LesserencePOSDB
# DB_USER=sa
# DB_PASSWORD=TuPassword123!
# DB_TRUSTED_CONNECTION=yes

# --- Seguridad JWT ---
SECRET_KEY=cambiar_esta_clave_secreta_por_una_muy_larga_y_aleatoria_en_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (orígenes permitidos para el frontend React en puerto 3050) ---
CORS_ORIGINS=http://localhost:3050,http://127.0.0.1:3050

# --- Configuración fiscal (República Dominicana) ---
ITBIS_PORCENTAJE=18.00
MONEDA_SIMBOLO=$
